# Secrets — never commit
.env
.env.*
!.env.example
*Copy.env
*- Copy.env

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs / local dumps (not schema SQL)
logs/
*.log
*.dump
*.sha256
*.backup

# User uploads (evidence / recordings) — live on a persistent volume, never in Git
uploads/

# Local test / scratch artifacts
test_azure_db.py
test_azure_db.py.txt

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Credential-bearing helper files and key material (a ci_env.sh helper once ended up in a
# Railway source upload). Never track or upload these; deploy from `git archive` exports.
ci_env*
*_env.sh
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

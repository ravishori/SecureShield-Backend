# Copy this file to backend/.env and fill in real values.
# Do not commit real secrets. Values with spaces or < > must be quoted.

# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/SecureShieldDB
MIGRATOR_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/SecureShieldDB

# Auth
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI
ANTHROPIC_API_KEY=

# Threat intel
GOOGLE_SAFE_BROWSING_API_KEY=

# EMAIL (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD="your gmail app password"
SMTP_FROM_EMAIL="SecureShield AI <you@gmail.com>"
ERROR_NOTIFY_EMAIL=you@gmail.com

# TWILIO (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# Observability
ADMIN_TOKEN=
SQL_ECHO=false

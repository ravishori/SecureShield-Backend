# Copy to .env and fill in real values. Do not commit .env.

# Azure Database for PostgreSQL — FastAPI runtime (secureshield_app)
DATABASE_URL=postgresql+asyncpg://secureshield_app:YOUR_APP_PASSWORD@secureshield-pg-prod.postgres.database.azure.com:5432/SecureShieldDB?ssl=require

# Azure Database for PostgreSQL — Alembic only (secureshield_migrator)
MIGRATOR_DATABASE_URL=postgresql+asyncpg://secureshield_migrator:YOUR_MIGRATOR_PASSWORD@secureshield-pg-prod.postgres.database.azure.com:5432/SecureShieldDB?ssl=require

SECRET_KEY=YOUR_SECRET_KEY
ALGORITHM=HS256

ANTHROPIC_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ERROR_NOTIFY_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Required for /api/v1/admin/* — no weak default; leave empty to disable admin API
ADMIN_TOKEN=

# Browser CORS only (comma-separated). Empty = local/dev (* without credentials).
# Native Android does not need CORS. Do not put secrets here.
CORS_ALLOWED_ORIGINS=

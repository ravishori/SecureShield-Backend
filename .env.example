# Copy to .env.local (git-ignored), fill in YOUR values, and select it explicitly with SECURESHIELD_ENV_FILE (start.bat does this).
# The backend never reads backend/.env on its own. Never commit a file with real values.
# Precedence: process environment > the selected file > defaults.

# =====================================================================================================================
# LOCAL DEVELOPMENT (Stage 1.2) - the only database block that is ACTIVE in this example. Everything below it that names a
# hosted database (Railway, Neon) is commented out and is for staging/production process variables, never for a laptop.
#   * the databases and roles are created once, by hand, with docs/database/STAGE_1_2_LOCAL_DATABASE_SETUP.sql
#   * passwords are set by hand with psql's \password and typed ONLY into your untracked .env.local (or your shell)
#   * the production database name (SecureShieldDB) is refused outside production, on any host
# Verify before you start:   python -m app.cli.show_database_target --expect development      (makes no connection)
# =====================================================================================================================
ENVIRONMENT=development
DATABASE_ENVIRONMENT=local
# Runtime: the least-privilege application role (rows only). Migrations: the owner role (Alembic only).
DATABASE_URL=postgresql+asyncpg://secureshield_dev_app:YOUR_DEV_APP_PASSWORD@localhost:5432/secureshield_dev
MIGRATOR_DATABASE_URL=postgresql+asyncpg://secureshield_dev_owner:YOUR_DEV_OWNER_PASSWORD@localhost:5432/secureshield_dev
# Nothing is deleted at startup; leave retention off locally. Real notifications are off locally unless you opt in.
# RETENTION_CLEANUP_ENABLED=false
# GUARDIAN_WORKER_ENABLED=false
AI_PROCESSING_ENABLED=false
# --- Integration tests use a SEPARATE database and are NOT configured here --------------------------------------------------
# Put TEST_DATABASE_URL in your shell (process environment) only when you run them, never in .env.local:
#   TEST_DATABASE_URL=postgresql+asyncpg://secureshield_test_owner:YOUR_TEST_OWNER_PASSWORD@localhost:5432/secureshield_test
# It must be loopback and end in "_test"; the harness refuses anything else and never falls back to the development database.

# Railway PostgreSQL. Railway/most hosts give postgres:// or postgresql:// URLs;
# the app rewrites them to postgresql+asyncpg:// (see app/config.py). If SSL is
# needed use ?ssl=require (asyncpg) - NOT ?sslmode=require.
# STAGING/PRODUCTION ONLY (set as process variables on the host, with ENVIRONMENT/DATABASE_ENVIRONMENT to match):
# Runtime role (secureshield_app) - FastAPI only.
# DATABASE_URL=postgresql+asyncpg://secureshield_app:YOUR_APP_PASSWORD@YOUR_RAILWAY_HOST:5432/railway

# Migration role (secureshield_migrator) - Alembic only.
# MIGRATOR_DATABASE_URL=postgresql+asyncpg://secureshield_migrator:YOUR_MIGRATOR_PASSWORD@YOUR_RAILWAY_HOST:5432/railway

# --- Neon PostgreSQL (placeholders only; copy the real values from the Neon console, never commit them) -------------
# Use the two Neon hosts for two different jobs (do not mix them):
#   * runtime (FastAPI)  -> the POOLED host   (contains "-pooler")        -> DATABASE_URL
#   * Alembic / admin / backups -> the DIRECT host (no "-pooler")         -> MIGRATOR_DATABASE_URL
# Neon's console string ends with "?sslmode=require&channel_binding=require". The app rewrites sslmode to ssl and
# ignores channel_binding (asyncpg does not support it), so you may paste it as is.
# asyncpg integer options in the URL (for example statement_cache_size=0 for a PgBouncer-style pooler) are accepted and
# passed to asyncpg as integers (app/database.py).
# DATABASE_URL=postgresql+asyncpg://YOUR_NEON_ROLE:YOUR_NEON_PASSWORD@ep-YOUR-ENDPOINT-pooler.YOUR_REGION.aws.neon.tech:5432/YOUR_DB?ssl=require&statement_cache_size=0
# MIGRATOR_DATABASE_URL=postgresql+asyncpg://YOUR_NEON_ROLE:YOUR_NEON_PASSWORD@ep-YOUR-ENDPOINT.YOUR_REGION.aws.neon.tech:5432/YOUR_DB?ssl=require
# Local PostgreSQL kept as the rollback source. NOT read by the application; the migration scripts in
# docs/neon-migration/scripts use it for the backup and the data copy.
# LOCAL_DATABASE_URL=postgresql://YOUR_LOCAL_USER:YOUR_LOCAL_PASSWORD@localhost:5432/YOUR_LOCAL_DB

SECRET_KEY=YOUR_SECRET_KEY
ALGORITHM=HS256

ANTHROPIC_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# abuse.ch URLhaus Auth-Key (free): https://auth.abuse.ch/ ; optional
URLHAUS_AUTH_KEY=

# E-mail and SMS providers are OPTIONAL. Leave these empty to run with no provider: OTP e-mail/SMS, guardian notices, login alerts and
# error alerts then report "not configured" and send nothing (login and every other flow keeps working). SMTP needs ALL of host,
# user, password and sender; Resend needs the key AND the sender; Twilio needs account SID (AC...), token and a number.
# SMTP_PORT is the one exception: it stays a required, validated integer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_CLIENT_IDS=
ERROR_NOTIFY_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Required for /api/v1/admin/* — no weak default; leave empty to disable admin API
ADMIN_TOKEN=

# Browser CORS only (comma-separated). Empty = local/dev (* without credentials).
# Native Android does not need CORS. Do not put secrets here.
CORS_ALLOWED_ORIGINS=
FILE_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEYS=
FILE_ENCRYPTION_ACTIVE_KEY_ID=

# --- Trusted reverse proxies (client IP for rate limiting) - FG-167 -------------------------------------
# Comma-separated IPs / CIDR ranges of the proxies whose X-Forwarded-For may be believed. Empty = believe no
# forwarding header (the TCP peer is the client). REQUIRED when the app sits behind a proxy (production refuses
# to boot with TRUST_PROXY_TLS=true and this empty). Wildcards are rejected. Also passed to uvicorn as
# --forwarded-allow-ips by the Dockerfile. Find your platform's proxy range - do not guess.
TRUSTED_PROXIES=

# --- Environment selection and database identity (Stage 1.1) -------------------------------------------------------
# The application does NOT read backend/.env implicitly. Select an env file with the process variable
# SECURESHIELD_ENV_FILE (a selected file that does not exist is an error). Precedence: process environment >
# the selected file > defaults.
# ENVIRONMENT:          development | test | staging | production
# DATABASE_ENVIRONMENT: local | test | staging | production  (must match ENVIRONMENT: development->local)
# Development/test may only use a loopback database, or a host listed in DEV_DATABASE_ALLOWED_HOSTS (exact endpoint id or
# hostname; no wildcards). Endpoints in config/production_endpoints.txt (production and the recovery branch) are refused
# outside production. DATABASE_URL must not carry host/port/database/user query parameters (refused at startup).
# ENVIRONMENT=development
# DATABASE_ENVIRONMENT=local
# DEV_DATABASE_ALLOWED_HOSTS=
# PRODUCTION_DATABASE_ENDPOINTS=      # adds to the committed registry; never removes entries

# --- Retention (link scans, error logs, guardian outbox) -------------------------------------------------------
# Deletion happens ONLY when this is exactly "true" (and the database identity is valid). Unset = off.
# Production must set it explicitly to true or false. Nothing is deleted at application startup.
# RETENTION_CLEANUP_ENABLED=false

# --- Guardian-alert worker (independent of Twilio) ---------------------------------------------------------------
# The worker can SEND real SMS / e-mail to guardians. Unset = ON in production only, OFF in development/test/staging.
# Set GUARDIAN_WORKER_ENABLED=true to run it elsewhere, false to switch it off anywhere.
# GUARDIAN_WORKER_ENABLED=false
# GUARDIAN_OUTBOX_POLL_SECONDS=30     # read through the same settings as everything else; 0 or less disables the worker

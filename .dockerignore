# Secrets and local env - never bake into the image
.env
.env.*
!.env.example
*Copy.env
*- Copy.env

# VCS / IDE
.git
.gitignore
.idea
.vscode

# Python environments and caches
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
*$py.class
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache

# Logs, dumps, backups
logs
*.log
*.dump
*.backup

# Local/dev-only artifacts
start.bat
test_azure_db.py
test_azure_db.py.txt
uploads

# Docs / misc that are not required at runtime
*.md
Dockerfile
.dockerignore

# Explicit deny-list for anything credential-bearing, at ANY depth (Docker patterns without
# **/ only match the context root). The image only COPYs app/, alembic/, alembic.ini and
# requirements.txt, but the whole context is uploaded to the builder, so keep it clean.
**/.env
**/.env.*
!.env.example
**/ci_env*
**/*_env.sh
**/*.sh
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa*
**/id_ed25519*
**/*.log
**/*.dump
**/*.sql
**/__pycache__
# Not needed in the image
tests
.github
docs
scripts
pytest.ini
.gitleaks.toml
requirements-seed.txt

.railway
node_modules
package.json
package-lock.json
